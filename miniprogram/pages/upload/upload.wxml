<view class="container">
  <view class="card">
    <text class="text-large" style="font-weight: bold;">选择文件</text>
    <view class="text-muted text-small mt-10">支持批量选择，单个文件最大10MB</view>
    
    <view class="upload-options mt-30">
      <view class="upload-option" bindtap="onChooseFromChat">
        <text style="font-size: 50rpx;">💬</text>
        <text class="mt-10">从聊天记录</text>
      </view>
      <view class="upload-option" bindtap="onChooseFromLocal">
        <text style="font-size: 50rpx;">📱</text>
        <text class="mt-10">从手机本地</text>
      </view>
      <view class="upload-option" bindtap="onChooseImages">
        <text style="font-size: 50rpx;">🖼️</text>
        <text class="mt-10">选择图片</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{files.length > 0}}">
    <view class="flex-between">
      <text class="text-large" style="font-weight: bold;">已选择 {{files.length}} 个文件</text>
      <text class="text-danger" bindtap="onClearAll">清空</text>
    </view>
    
    <view class="file-list mt-20">
      <view class="file-item" wx:for="{{files}}" wx:key="id">
        <text class="file-icon">{{item.icon}}</text>
        <view class="file-info">
          <view class="file-name">{{item.name}}</view>
          <view class="file-size">{{item.sizeText}} · {{item.formatName}}</view>
        </view>
        <text class="remove-btn" data-id="{{item.id}}" bindtap="onRemoveFile">✕</text>
      </view>
    </view>

    <view class="btn-primary mt-30" style="text-align: center;" bindtap="onStartConvert">
      下一步：选择目标格式
    </view>
  </view>

  <view class="card" wx:if="{{files.length === 0}}">
    <view class="empty-state">
      <text class="empty-icon">📁</text>
      <text class="empty-text">还没有选择文件</text>
      <text class="text-muted text-small mt-10">点击上方按钮选择文件开始转换</text>
    </view>
  </view>
</view>
