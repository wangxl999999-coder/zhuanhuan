<view class="container">
  <view class="privacy-banner" wx:if="{{privacyNeedAuth}}" bindtap="onOpenPrivacy">
    <text class="privacy-banner-icon">🔒</text>
    <text class="privacy-banner-text">需要同意隐私协议后才能选择文件，点击去授权</text>
    <text class="privacy-banner-arrow">›</text>
  </view>

  <view class="card">
    <text class="text-large" style="font-weight: bold;">选择文件</text>
    <view class="text-muted text-small mt-10">支持 Word、Excel、PPT、PDF、Markdown、图片等格式</view>
    <view class="text-muted text-small mt-5">单个文件最大10MB，可批量选择</view>
    
    <view class="upload-options mt-30">
      <view class="upload-option" bindtap="onChooseFromLocal">
        <text class="upload-icon">📁</text>
        <text class="upload-text mt-10">手机本地</text>
        <text class="upload-hint">选择文件</text>
      </view>
      <view class="upload-option" bindtap="onChooseImages">
        <text class="upload-icon">📷</text>
        <text class="upload-text mt-10">拍照/相册</text>
        <text class="upload-hint">选择图片</text>
      </view>
      <view class="upload-option" bindtap="onChooseFromChat">
        <text class="upload-icon">💬</text>
        <text class="upload-text mt-10">聊天记录</text>
        <text class="upload-hint">从微信选择</text>
      </view>
    </view>

    <view class="format-tags mt-20">
      <view class="format-tag">📄 Word</view>
      <view class="format-tag">📊 Excel</view>
      <view class="format-tag">📽️ PPT</view>
      <view class="format-tag">📕 PDF</view>
      <view class="format-tag">📝 Markdown</view>
      <view class="format-tag">🖼️ 图片</view>
    </view>

    <view class="privacy-hint mt-20" bindtap="onOpenPrivacy">
      <text class="text-small text-muted">🔒 使用文件功能需同意</text>
      <text class="text-small privacy-link">《隐私协议》</text>
    </view>

    <view class="dev-hint mt-20" wx:if="{{true}}" bindtap="onChooseMock">
      <text class="text-small">🧪 开发测试：</text>
      <text class="text-small privacy-link">选择模拟文件</text>
    </view>
  </view>

  <view class="card" wx:if="{{files.length > 0}}">
    <view class="flex-between">
      <text class="text-large" style="font-weight: bold;">已选择 {{files.length}} 个文件</text>
      <text class="text-danger" bindtap="onClearAll">清空</text>
    </view>
    
    <view class="file-list mt-20">
      <view class="file-item" wx:for="{{files}}" wx:key="id">
        <text class="file-icon">{{item.icon}}</text>
        <view class="file-info">
          <view class="file-name">{{item.name}}</view>
          <view class="file-size">{{item.sizeText}} · {{item.formatName}}</view>
        </view>
        <text class="remove-btn" data-id="{{item.id}}" bindtap="onRemoveFile">✕</text>
      </view>
    </view>

    <view class="btn-primary mt-30" style="text-align: center;" bindtap="onStartConvert">
      下一步：选择目标格式
    </view>
  </view>

  <view class="card" wx:if="{{files.length === 0}}">
    <view class="empty-state">
      <text class="empty-icon">📤</text>
      <text class="empty-text">还没有选择文件</text>
      <text class="text-muted text-small mt-10">点击上方按钮选择文件开始转换</text>
    </view>
  </view>
</view>
