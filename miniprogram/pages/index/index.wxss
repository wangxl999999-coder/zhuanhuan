.header {
  background: linear-gradient(135deg, #1677ff 0%, #0958d9 100%);
  color: #fff;
}

.header .text-large {
  color: #fff;
}

.header .text-primary {
  color: #fff !important;
}

.header .text-muted {
  color: rgba(255, 255, 255, 0.7);
}

.header .btn-secondary {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: none;
}

.convert-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.convert-item {
  width: calc(33.33% - 14rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 10rpx;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  transition: all 0.2s;
}

.convert-item:active {
  transform: scale(0.95);
  background-color: #f0f0f0;
}

.convert-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.convert-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
}

.upload-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  border: 4rpx dashed #ddd;
  border-radius: 16rpx;
  background-color: #fafafa;
}

.upload-btn:active {
  background-color: #f0f0f0;
  border-color: #1677ff;
}

.recent-list {
  max-height: 400rpx;
  overflow-y: auto;
}
