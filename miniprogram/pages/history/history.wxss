.header-card {
  margin-bottom: 20rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
  font-size: 24rpx;
  color: #666;
}

.action-btn:active {
  background-color: #f0f0f0;
}

.delete-btn:active {
  background-color: #ffebe8;
  color: #fa5151;
}

.ml-10 {
  margin-left: 10rpx;
}
