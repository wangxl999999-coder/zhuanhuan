.success-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
}

.action-btn:active {
  background-color: #f0f0f0;
}

.mt-5 {
  margin-top: 5rpx;
}

.footer-actions {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}
